# Run sh prepare.sh on the server to generate database/Redis passwords.
MYSQL_ROOT_PASSWORD=__GENERATE_ROOT__
MYSQL_PASSWORD=__GENERATE_DB__
REDIS_PASSWORD=__GENERATE_REDIS__

# Required: a registered account's email; this setting does not create an account.
INNOCENCE_ADMIN_EMAILS=

# Leave these defaults only for infrastructure checks without email delivery.
# For real registration, fill in your SMTP service on the server.
INNOCENCE_MAIL_HOST=smtp.invalid
INNOCENCE_MAIL_PORT=465
INNOCENCE_MAIL_USERNAME=not-configured@example.invalid
INNOCENCE_MAIL_PASSWORD=
INNOCENCE_MAIL_SSL=true
INNOCENCE_MAIL_STARTTLS=false
